<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DriveNext" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:fontFamily">@font/montserrat_family</item>
        <item name="materialButtonStyle">@style/Widget.DriveNext.Button</item>
    </style>

    <style name="Theme.DriveNext.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_empty</item>
        <item name="postSplashScreenTheme">@style/Theme.DriveNext</item>
    </style>

</resources>
