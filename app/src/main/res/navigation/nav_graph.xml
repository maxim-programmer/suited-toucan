<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/navigation/nav_graph.xml -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.drivenext.presentation.splash.SplashFragment"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_noConnection"
            app:destination="@id/noConnectionFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_onboarding"
            app:destination="@id/onboardingFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_auth"
            app:destination="@id/authPlaceholderFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/noConnectionFragment"
        android:name="com.example.drivenext.presentation.noconnection.NoConnectionFragment"
        tools:layout="@layout/fragment_no_connection">
        <action
            android:id="@+id/action_noConnection_to_onboarding"
            app:destination="@id/onboardingFragment"
            app:popUpTo="@id/noConnectionFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_noConnection_to_auth"
            app:destination="@id/authPlaceholderFragment"
            app:popUpTo="@id/noConnectionFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.example.drivenext.presentation.onboarding.OnboardingFragment"
        tools:layout="@layout/fragment_onboarding">
        <action
            android:id="@+id/action_onboarding_to_auth"
            app:destination="@id/authPlaceholderFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/authPlaceholderFragment"
        android:name="com.example.drivenext.presentation.auth.AuthPlaceholderFragment"
        tools:layout="@layout/fragment_auth_placeholder" />

</navigation>
